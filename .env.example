# ==============================================================================
# ETGNN-Agent: Research Demonstration Platform - Environment Configuration
# ==============================================================================
# Copy this file to .env before starting the platform:
#   Copy-Item .env.example .env
#
# IMPORTANT:
# - All keys are optional for local demo execution.
# - If no live LLM API keys are configured, the system operates deterministically
#   in SIMULATED / EVIDENCE-ONLY mode using frozen Elliptic graph evidence.
# ==============================================================================

# Server Network Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Optional Live LLM Providers (Leave blank if not using live external providers)
# 1. Google Gemini (Recommended for production live inference)
GEMINI_API_KEY=

# 2. Anthropic Claude
ANTHROPIC_API_KEY=

# 3. OpenAI
OPENAI_API_KEY=

# 4. Local Ollama Host (e.g., http://localhost:11434)
OLLAMA_HOST=

# Telemetry and Tracking (Optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=

# Epistemic & Continual Learning Safety Invariants
CONTINUAL_LEARNING_LOCKED=true
PROMOTION_GATE_STATUS=BLOCKED
CHECKPOINT_DIRECTORY=results/checkpoints
DATASET_DIRECTORY=data/raw

